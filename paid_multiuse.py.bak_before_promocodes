async def show_tenant_dzen(
    message: Message,
    user_id: int,
) -> None:
    _, cfg, _ = _deps()

    row = await tenant_db.tenant_dzen_account(
        user_id
    )

    used = await tenant_db.successful_dzen_replies_today(
        user_id,
        cfg.timezone,
    )

    remaining = max(0, 3 - used)

    if row:
        comments_url = str(
            row["comments_url"] or ""
