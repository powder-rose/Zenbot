async def create_payment(
    message: Message,
    user_id: int | None = None,
) -> None:
    user_id = int(
        user_id
        if user_id is not None
        else message.from_user.id
    )

    bot, _, _ = _deps()

    if user_id == bot.id:
        raise RuntimeError(
            "CloudPayments payer cannot be bot"
        )
    if await tenant_db.is_subscription_active(
        user_id
    ):
        await message.answer(
            "✅ Подписка уже активна.",
            reply_markup=cabinet_keyboard(),
        )
        return

    try:
        order = await create_cloudpayments_order(
            user_id
        )
    except Exception:
        log.exception(
            "Ошибка создания CloudPayments order: "
            "user=%s",
            user_id,
        )

        await message.answer(
            "❌ Сейчас не удалось создать "
            "ссылку на оплату. "
            "Попробуйте немного позже."
        )
        return

    keyboard = InlineKeyboardMarkup(
        inline_keyboard=[
            [
                InlineKeyboardButton(
                    text="💳 Оплатить 1 200 ₽",
                    url=order["url"],
                )
            ],
            [
                InlineKeyboardButton(
                    text="⬅️ Назад",
                    callback_data="billing:status",
                )
            ],
        ]
    )

    await message.answer(
        "💳 <b>Подписка на 30 дней</b>\n\n"
        "Стоимость: <b>1 200 ₽</b>.\n\n"
        "После успешной оплаты доступ "
        "активируется автоматически.",
        parse_mode="HTML",
        reply_markup=keyboard,
    )


